# Copy to .env and fill in your values.
# Never commit .env — it is gitignored.

# Vision / Gemini (optional for camera companion)
GEMINI_API_KEY=

# Backend database. Leave unset for local SQLite (backend/prodpet.db).
# For Tiger Cloud / TimescaleDB, paste the Postgres connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=

# Supabase Auth (backend)
# Leave cloud values blank to use local accounts.
SUPABASE_URL=
# Optional: only needed for legacy HS256 projects
SUPABASE_JWT_SECRET=

# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the API (deployed site).
# FRONTEND_ORIGIN=http://YOUR_VULTR_IP

# VITE_ROBOT_LINK_URL=http://127.0.0.1:8765
