# A real public hostname whose DNS points at your Vultr server.
# No https:// prefix, port, or trailing slash.
APP_DOMAIN=study.example.com
# Used for the HTTPS certificate account; replace before deployment.
ACME_EMAIL=you@example.com

# Optional cloud login. Use only a public anon/publishable key here.
# Set both Supabase values and the HTTPS URL of a separately hosted FastAPI API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
